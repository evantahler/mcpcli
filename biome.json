{
	"$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
	"files": {
		"includes": ["**", "!!**/node_modules", "!!**/dist", "!!**/bun.lock", "!!**/.claude"]
	},
	"formatter": {
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noTemplateCurlyInString": "off",
				"noNonNullAssertedOptionalChain": "off"
			}
		}
	}
}
